# Copia como .env.local para probar con Supabase en tu computadora.
# Solo la URL y la llave PUBLICABLE (sb_publishable_...). Nunca la secret key ni la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional. Dónde está la biblioteca de animaciones privada (tablas que NO van al repositorio ni a la página).
# Solo para probar en tu computadora; sin ella todo funciona con las animaciones de siempre.
VITE_ANIM_BIBLIOTECA_URL=
